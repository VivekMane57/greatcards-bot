# Pick ONE provider. Gemini free tier works via the "openai" provider (OpenAI-compatible endpoint).
PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-5

# --- Gemini free tier example ---
# PROVIDER=openai
# OPENAI_API_KEY=<your Gemini API key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-2.5-flash

MCP_URL=https://bk-api.bankkaro.com/mcp
PROMPT=guarded                # guarded | baseline  (baseline = before-fix, for transcripts)
STRICT_AMOUNTS=1              # 1 = block rupee figures that tools did not return

# Expose only the 5 documented tools to the LLM (server also lists whatsapp_*, run_api_diagnostics, etc.).
# Leave empty to expose everything (use that for the "before" run to see if the model misuses extra tools).
# ALLOWED_TOOLS=recommend_cards,get_card_details,list_cards,compare_cards,check_eligibility
